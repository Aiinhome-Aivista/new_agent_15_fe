# ── DEVAA Frontend Environment Variables Example ───────────────
VITE_APP_TITLE=DEVAA
VITE_PORT=5173
VITE_API_BASE_URL=/api
VITE_BACKEND_TARGET=http://127.0.0.1:5000

# ── Sync & Polling Configuration ──────────────────────────────
# Auto-sync interval with Jira in minutes (default: 10)
VITE_SYNC_INTERVAL_MINUTES=10

# Live pipeline log polling frequency in milliseconds (default: 2000)
VITE_POLL_INTERVAL_MS=2000
